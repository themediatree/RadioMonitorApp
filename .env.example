# =============================================================================
# RadioMonitor Web App -- Environment configuration
# =============================================================================
# Copy this to .env and fill in real values. .env is gitignored.
# In production set these via the actual environment (systemd, IIS, etc.),
# not by committing a .env file.

# --- App ---
APP_NAME=RadioMonitor
APP_ENV=development              # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# Host/port uvicorn binds to when running `python main.py`
HOST=0.0.0.0
PORT=8000

# Comma-separated allowed origins for CORS (only relevant if you build a SPA later)
CORS_ORIGINS=http://localhost:8000

# Base URL the app is served from (used in invitation links, password resets, etc.)
BASE_URL=http://localhost:8000

# --- Database ---
# SQL Server connection. Two options:
#
# Option 1 -- DSN-less (recommended). Pyodbc connection string fragments:
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=RadioMonitor
DB_TRUSTED_CONNECTION=no         # AUDIOREC uses a SQL login, NOT Windows auth
DB_USER=radiomonitor_user
DB_PASSWORD=                     # set the SQL login password here
DB_ENCRYPT=yes                   # ODBC Driver 18 defaults to Encrypt=yes
DB_TRUST_SERVER_CERTIFICATE=yes  # SQL Express self-signed cert on AUDIOREC
#
# Option 2 -- direct override. If set, this URL is used and the fields above are ignored:
# DATABASE_URL=mssql+pyodbc://radiomonitor_user:pass@localhost\SQLEXPRESS/RadioMonitor?driver=ODBC+Driver+18+for+SQL+Server

# Connection pool tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800             # seconds; recycle conns to avoid SQL Server idle timeouts

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_GENERATED_WITH_SECRETS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60      # access token lifetime
JWT_REFRESH_TOKEN_DAYS=14        # refresh token lifetime (not used Phase 1)

# Session cookie settings
SESSION_COOKIE_NAME=rm_session
SESSION_COOKIE_SECURE=false      # 'true' in production behind HTTPS
SESSION_COOKIE_SAMESITE=lax      # lax | strict | none

# Password policy
PASSWORD_MIN_LENGTH=10

# --- Paths (all LOCAL to AUDIOREC; pipeline writes here over UNC, web app reads here) ---
# The DB stores full D:\ paths. The web app runs on AUDIOREC and reads them directly.
PIPELINE_DATA_ROOT=D:\RadioMonitor
CLIPS_PATH=D:\RadioMonitor\clips
AUDIO_PATH=D:\RadioMonitor\audio
TRANSCRIPTS_PATH=D:\RadioMonitor\transcripts

# Where the web app SAVES client-uploaded commercial samples (Phase 6).
# Per-station subfolders split by category; real paths resolve like
#   D:\RadioMonitor\data\<station>\generic\...
#   D:\RadioMonitor\data\<station>\liveread\...
# The pipeline's library-manager reads from here to build its library nightly.
# NOT used in Phase 1 -- present so the paths are documented up front.
SAMPLES_GENERIC_ROOT=D:\RadioMonitor\data
SAMPLES_LIVEREAD_ROOT=D:\RadioMonitor\data

# --- Email (Phase 2; placeholders for now) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@radiomonitor.example
SMTP_USE_TLS=true
